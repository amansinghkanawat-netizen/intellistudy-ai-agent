# IntelliStudy Backend Environment Variables
# Copy this file to .env and fill in your credentials.

# ─── Application ──────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Database ─────────────────────────────────────────────────────────────
# PostgreSQL (production)
DATABASE_URL=postgresql://intellistudy_user:your_password@localhost:5432/intellistudy_db

# SQLite (development fallback — used automatically when DATABASE_URL is not set)
# Leave DATABASE_URL blank to use SQLite: sqlite:///./intellistudy.db

# ─── IBM watsonx.ai ────────────────────────────────────────────────────────
# Get credentials from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model IDs
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2
GRANITE_EMBEDDING_MODEL=ibm/slate-125m-english-rtrvr

# ─── IBM Cloud Object Storage ─────────────────────────────────────────────
IBM_COS_API_KEY=
IBM_COS_INSTANCE_CRN=
IBM_COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
IBM_COS_BUCKET=intellistudy-uploads

# ─── File Upload ──────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=./storage/uploads
ALLOWED_EXTENSIONS=pdf,docx,txt,jpg,jpeg,png

# ─── RAG ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K_CHUNKS=5
VECTOR_STORE_PATH=./storage/vector_store

# ─── Frontend ─────────────────────────────────────────────────────────────
# Frontend environment variables (place in frontend/.env)
VITE_API_URL=http://localhost:8000

# ─── Rate Limiting (TODO for production) ─────────────────────────────────
# RATE_LIMIT_LOGIN=10/minute
# RATE_LIMIT_REGISTER=5/minute
# REDIS_URL=redis://localhost:6379
